# ── Article view counter (optional) ─────────────────────────────────────────
# Powers the 👁 view badge on articles + resources via /api/views/[slug].
# Create a free Redis database at https://console.upstash.com and paste its
# REST URL + REST token here. With these UNSET, the counter silently hides and
# everything else works normally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Search-engine indexing ──────────────────────────────────────────────────
# Set to "true" at launch to allow indexing (default: noindex until then).
# NEXT_PUBLIC_ALLOW_INDEX=false
