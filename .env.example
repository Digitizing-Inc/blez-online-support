# Blez Online Support — environment variables
# Copy to `.env.local` for local dev, and set these in the deploy environment.
# All are optional; sane defaults ship in src/lib/config.ts.

# Canonical site URL. Used by Next's metadataBase, the sitemap, and robots.
# Default: https://support.blezonline.com
NEXT_PUBLIC_SITE_URL=

# Search-engine indexing switch. OFF by default so the prototype's placeholder
# article bodies are not indexed as thin/duplicate content. Set to "true" once
# real article copy is wired — this flips article/topic pages to indexable and
# restores them to the sitemap. The home page is always indexable.
NEXT_PUBLIC_ALLOW_INDEX=false
